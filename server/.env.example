PORT=3000
ZHIPU_API_KEY=替换为你自己的智谱API密钥
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4.5-flash

# Optional multilingual embeddings. With Zhipu, reuse ZHIPU credentials.
RAG_EMBEDDING_MODEL=embedding-3
# Override both for a different OpenAI-compatible provider:
# RAG_EMBEDDING_BASE_URL=
# RAG_EMBEDDING_API_KEY=
RAG_RETRIEVAL_MODE=keyword
